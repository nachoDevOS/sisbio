# =============================================================================
# SisMark — variables de entorno del contenedor
#
# En Coolify NO se sube este archivo: su contenido se pega en la solapa
# «Environment Variables» del recurso.
#
# Para probar en la PC:
#     cp .env.docker.example .env.docker
#     docker run -d --name sismark-app --network sismark-net \
#                --env-file .env.docker -p 8010:8000 sismark
#
# OJO con las comillas: `--env-file` de Docker NO las quita. `APP_NAME="X"`
# entra literalmente con las comillas incluidas. Por eso acá van sin comillas,
# aunque el valor tenga espacios.
#
# El `.env.docker` no se versiona y no entra en la imagen (.dockerignore).
# =============================================================================


# -----------------------------------------------------------------------------
# 1. APLICACIÓN  (obligatorio)
# -----------------------------------------------------------------------------
APP_NAME=SisMark
APP_ENV=production

# OBLIGATORIO. Sin esto el contenedor se niega a arrancar.
# Generarla una vez con:
#     docker run --rm sismark php artisan key:generate --show
# y pegar el resultado completo (incluye el prefijo "base64:").
# Si se cambia después, las sesiones y todo lo cifrado se pierden.
APP_KEY=

# En producción SIEMPRE false: en true, cualquier error muestra las variables
# de entorno enteras —con la clave de Mamoré y la contraseña de la base— en el
# navegador.
APP_DEBUG=false

# OBLIGATORIO. El dominio que se le asigna al recurso en Coolify, con https.
# Lo usan los enlaces, los QR de los reportes imprimibles y las redirecciones.
APP_URL=https://sismark.beni.gob.bo

# Hora de Bolivia (UTC-4). Los relojes guardan en hora local y el procesador de
# asistencia compara marcas contra horarios sin zona horaria: cambiar esto
# desplaza todos los atrasos calculados.
APP_TIMEZONE=America/La_Paz

APP_LOCALE=es
APP_FALLBACK_LOCALE=en


# -----------------------------------------------------------------------------
# 2. BASE DE DATOS MySQL  (obligatorio)
#
# La base es un recurso APARTE, no viene en la imagen:
#     Coolify → «+ New» → «Database» → «MySQL»
#
# Una vez creada, Coolify muestra sus credenciales y su nombre de host interno.
# Ese host es el que va en DB_HOST (no una IP, no «localhost»). El recurso de
# la aplicación y el de la base tienen que estar en el MISMO proyecto para
# verse por la red interna.
#
# Probando en la PC, DB_HOST es el nombre del contenedor de MySQL
# (por ejemplo `sismark-mysql`), con los dos en la misma red de Docker.
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=sismark
DB_USERNAME=
DB_PASSWORD=

# > La base ya viene migrada del SIA: la copia SQL Server → MySQL se hace en
# > local con `php artisan sia:migrar-*` y después se sube el volcado. La
# > imagen NO trae el driver de SQL Server.


# -----------------------------------------------------------------------------
# 3. MICROSERVICIO DE BIOMÉTRICOS  (obligatorio)
#
# Hay dos formas de correrlo. Elegir UNA:
#
#   a) CONTENEDOR APARTE (por defecto). Tiene su propio Dockerfile en
#      `device-service/` y se despliega como un segundo recurso. La URL apunta a
#      su nombre de contenedor (o al del recurso en Coolify):
#           SISMARK_DEVICE_SERVICE=false
#           DEVICE_SERVICE_URL=http://sismark-devices:9001
#      Es lo que conviene cuando el microservicio tiene que vivir en otra
#      máquina que la aplicación —el caso normal, ver el aviso de más abajo.
#
#   b) EMBEBIDO en este mismo contenedor. El entrypoint lo arranca junto con la
#      aplicación, escuchando solo en 127.0.0.1:
#           SISMARK_DEVICE_SERVICE=true
#           DEVICE_SERVICE_URL=http://127.0.0.1:9001
#      Un solo recurso que administrar, pero si el proceso se cae no se
#      reinicia solo: hay que reiniciar el contenedor.
#
# `127.0.0.1` con la opción (a) es el error más común: dentro del contenedor
# apunta al contenedor mismo, donde no hay ningún microservicio escuchando, y
# todas las acciones de equipos fallan con «no se pudo contactar al
# microservicio de dispositivos».
# -----------------------------------------------------------------------------
SISMARK_DEVICE_SERVICE=false
DEVICE_SERVICE_URL=http://sismark-devices:9001

# OBLIGATORIO. Token compartido: el MISMO valor de los dos lados.
# Generar uno largo y aleatorio:
#     openssl rand -hex 32
# Si queda vacío, el microservicio rechaza TODAS las peticiones (fail-closed)
# y las acciones de equipos dejan de funcionar.
DEVICE_SERVICE_TOKEN=

# > IMPORTANTE: el servidor donde corre el microservicio tiene que tener ruta
# > de red hasta el puerto 4370 de cada equipo. Si Coolify está en un VPS fuera
# > de la red del organismo, el microservicio NO puede vivir ahí: queda
# > corriendo en una máquina interna y se le apunta DEVICE_SERVICE_URL.


# -----------------------------------------------------------------------------
# 4. API DE MAMORÉ — datos personales de los funcionarios  (obligatorio)
#
# Es la fuente de nombres, cargos, direcciones administrativas y contratos.
# Sin esto, los listados de funcionarios, marcaciones y licencias muestran el
# carnet sin nombre, y los reportes salen sin cargo.
# -----------------------------------------------------------------------------

# URL con el prefijo completo, p. ej. https://mamore.beni.gob.bo/api/personal
MAMORE_API_URL=
MAMORE_API_KEY=


# -----------------------------------------------------------------------------
# 5. SESIONES, CACHÉ Y COLAS
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120

# Con HTTPS (Coolify lo termina en su proxy): cifra la sesión en la base.
SESSION_ENCRYPT=true

# El dominio real, o `null` para un solo host.
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local


# -----------------------------------------------------------------------------
# 6. LOGS
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single

# En producción `warning`: con `debug` cada consulta y cada aviso de la API de
# Mamoré engorda el log hasta llenar el disco.
LOG_LEVEL=warning


# -----------------------------------------------------------------------------
# 7. ARRANQUE DEL CONTENEDOR  (opcional)
# -----------------------------------------------------------------------------

# `true` en el PRIMER despliegue: crea los permisos y el rol `super_admin`.
# Después conviene volverlo a `false`.
SISMARK_SEED=false

# `true` para que el contenedor arranque sin correr `migrate --force`.
SISMARK_SKIP_MIGRATIONS=false


# =============================================================================
# LO QUE NO VA ACÁ
#
# DB_HOST_SIA / DB_PASSWORD_SIA y demás variables del SQL Server: son solo del
# entorno LOCAL, donde se corre la migración `sia:migrar-*`. La imagen de
# producción no trae el driver `pdo_sqlsrv`, así que ponerlas no hace nada.
# Viven en el `.env` de desarrollo (ver .env.example).
# =============================================================================
